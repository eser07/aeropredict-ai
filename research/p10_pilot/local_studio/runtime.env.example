# Fresh, disposable local development configuration; no personal secrets.
DBHOST=postgres
DBPORT=5432
DBNAME=genlayer_state
DBUSER=postgres
DBPASSWORD=aeropredict-local-development
REMOTE_DATABASE=false
RPCPORT=4000
WEBDRIVERHOST=webdriver
WEBDRIVERPORT=4444
REDIS_URL=redis://redis:6379/0
WEB_CONCURRENCY=1
LOG_LEVEL=info
LOGCONFIG=dev
GENVM_BIN=/genvm/bin
GENVMROOT=/genvm
GENVM_LLM_DEBUG=0
GENVM_WEB_DEBUG=0
GENLAYER_CHAIN_ID=61127
# v0.121.6's legacy transaction parser needs a Web3 codec instance even when
# the optional EVM node is offline. This points only to this container's
# unused loopback port; Studio's local DB consensus remains the execution path.
HARDHAT_URL=http://127.0.0.1
HARDHAT_PORT=8545
CONSENSUS_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
WORKER_PORT=4001
WORKER_POLL_INTERVAL=1
CONSENSUS_WORKERS=1
TRANSACTION_TIMEOUT_MINUTES=5
OLAMAPROTOCOL=http
OLAMAHOST=ollama
OLAMAPORT=11434
# Provider/model metadata only. No API key is configured. The tested contracts
# use deterministic constructors and numerical strict_eq; no exec_prompt calls.
# An attempted LLM call must fail due to missing credentials.
VALIDATORS_CONFIG_JSON='[{"stake":100,"provider":"openai","model":"gpt-4o","amount":5}]'
VITE_GENLAYER_NETWORK=localnet
VITE_CHAIN_ID=61127
VITE_CHAIN_NAME=AeroPredict Local Studio
VITE_JSON_RPC_SERVER_URL=http://127.0.0.1:4000/api
VITE_WS_SERVER_URL=ws://127.0.0.1:4000
VITE_IS_HOSTED=false
VITE_LOCK_NETWORK=true
VITE_FINALITY_WINDOW=5
VITE_FINALITY_WINDOW_APPEAL_FAILED_REDUCTION=0.2
VITE_MAX_ROTATIONS=3
VITE_APPKIT_PROJECT_ID=
VSCODEDEBUG=false
RATE_LIMIT_ENABLED=false
